PORT=5000
SITE_URL=https://coastaltrails.in
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=coastal_trails
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Google OAuth 2.0 (Google Identity Services Client ID)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Email (Google Workspace / Gmail SMTP with an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=bookings@yourdomain.in
SMTP_PASS=your_16_char_app_password

# Admin alerts for new bookings (defaults to SMTP_USER when unset)
MAIL_ADMIN=owner@yourdomain.in
MAIL_REPLY_TO=support@yourdomain.in

# Meta WhatsApp Cloud API (optional - delivers templates server-side)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v22.0
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_BOOKING_TEMPLATE=ct_booking_confirmed
WHATSAPP_PAYMENT_TEMPLATE=ct_payment_receipt
WHATSAPP_PAYMENT_FAILED_TEMPLATE=ct_payment_pending
WHATSAPP_SIGNUP_TEMPLATE=signup_welcome

# Twilio WhatsApp delivery (optional alternative)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
