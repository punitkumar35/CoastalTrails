PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=coastal_trails
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Email (Google Workspace / Gmail SMTP with an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=bookings@yourdomain.in
SMTP_PASS=your_16_char_app_password

# WhatsApp Cloud API (Meta)
# Phone Number ID: Meta app dashboard > WhatsApp > API Setup
# Access token: Business Settings > Users > System Users (permanent token)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_BOOKING_TEMPLATE=ct_booking_confirmed
WHATSAPP_PAYMENT_TEMPLATE=ct_payment_receipt
WHATSAPP_PAYMENT_FAILED_TEMPLATE=ct_payment_pending
WHATSAPP_SIGNUP_TEMPLATE=ct_welcome
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v22.0
